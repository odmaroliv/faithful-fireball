---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Something went wrong | Arnian Moving" noindex>
  <div class="min-h-[70vh] flex flex-col items-center justify-center px-4 py-16 md:py-24">
    <div class="text-center max-w-xl mx-auto">
      <div class="text-8xl md:text-9xl font-bold text-brand-primary mb-6">500</div>
      
      <h1 class="text-3xl md:text-4xl font-bold text-brand-primary mb-4">Something went wrong</h1>
      
      <p class="text-lg text-brand-gray mb-8">
        Please try again in a moment. If you need us now, call or WhatsApp us — we are happy to help.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="bg-brand-accent hover:bg-brand-accent/90 text-white font-medium py-3 px-6 rounded-md shadow-md hover:shadow-lg transition-all inline-flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 mr-2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Back to home
        </a>
      </div>
    </div>
  </div>
</Layout>