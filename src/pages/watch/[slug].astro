---
import Layout from "../../layouts/Layout.astro";
import { showcaseVideos } from "../../data/videos";
import { siteConfig } from "../../config/site";

export function getStaticPaths() {
  return showcaseVideos.map((video) => ({
    params: { slug: video.slug },
    props: { video },
  }));
}

const { video } = Astro.props;
const otherVideo = showcaseVideos.find((v) => v.slug !== video.slug);
const ogImage = `https://${siteConfig.domain}${video.poster}`;
---

<Layout
  title={`${video.title} | ${siteConfig.company.name}`}
  description={video.description}
  ogImage={ogImage}
  ogType="video.other"
  canonicalPath={`/watch/${video.slug}`}
>
  <main
    class="relative flex min-h-screen flex-col overflow-hidden bg-black"
  >
    <!-- Ambient blurred backdrop, colour-matched to the video -->
    <div
      class="pointer-events-none absolute -inset-10 scale-110 transform-gpu bg-black bg-cover bg-center opacity-70 blur-3xl brightness-[0.35] saturate-150"
      style={`background-image:url(${video.poster})`}
      aria-hidden="true"
    ></div>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/60 via-black/70 to-black"></div>

    <!-- Ambient glow -->
    <div class="pointer-events-none absolute -left-32 top-0 h-[28rem] w-[28rem] rounded-full bg-brand-secondary/20 blur-[120px]"></div>
    <div class="pointer-events-none absolute -right-32 bottom-0 h-[32rem] w-[32rem] rounded-full bg-brand-blue-light/15 blur-[130px]"></div>

    <!-- Pattern -->
    <div class="pointer-events-none absolute inset-0 opacity-[0.08]">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="watch-wave-pattern" width="140" height="140" patternUnits="userSpaceOnUse">
            <path d="M0,70 C28,56 49,14 70,14 C91,14 112,56 140,70 C168,84 189,126 210,126"
                  stroke="#ffffff" stroke-width="0.7" fill="none" stroke-opacity="0.5" />
            <path d="M0,98 C28,84 49,42 70,42 C91,42 112,84 140,98 C168,112 189,154 210,154"
                  stroke="#6b99ff" stroke-width="0.7" fill="none" stroke-opacity="0.4" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#watch-wave-pattern)" />
      </svg>
    </div>

    <!-- Minimal top bar -->
    <div class="relative z-10 flex items-center justify-between px-4 py-4 sm:px-6 sm:py-6">
      <a href="/" aria-label="Back to Arnian Moving home" class="flex items-center gap-2">
        <img src="/images/logo.png" alt={siteConfig.company.name} class="h-9 w-auto brightness-0 invert sm:h-10" />
      </a>
      <a
        href="/"
        aria-label="Close"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur-sm transition-colors hover:bg-white/20"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </a>
    </div>

    <!-- Video stage -->
    <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-4 pb-6 sm:px-6">
      <div
        id="watch-stage"
        class="relative aspect-[9/16] w-full max-w-[420px] flex-none overflow-hidden rounded-3xl bg-black shadow-[0_30px_90px_rgba(0,0,0,0.6)] ring-1 ring-white/10 sm:max-h-[80vh]"
        style={`view-transition-name: video-${video.slug}`}
      >
        <video
          id="watch-video"
          class="h-full w-full object-cover"
          src={video.src}
          poster={video.poster}
          muted
          playsinline
          autoplay
          preload="metadata"
          aria-label={video.label}
        ></video>

        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-black/60 to-transparent"></div>

        <button
          id="watch-sound-toggle"
          type="button"
          aria-label="Toggle sound"
          aria-pressed="false"
          class="absolute bottom-4 right-4 flex h-11 w-11 items-center justify-center rounded-full bg-black/50 text-white backdrop-blur-sm transition-colors hover:bg-black/70"
        >
          <svg id="watch-icon-muted" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 9.75L19.5 12m0 0l2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25M3 9.75h2.25l4.72-4.72a.75.75 0 011.28.53v12.88a.75.75 0 01-1.28.53L5.25 14.25H3a.75.75 0 01-.75-.75v-3a.75.75 0 01.75-.75z" />
          </svg>
          <svg id="watch-icon-unmuted" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.5a.75.75 0 01-.75-.75v-6a.75.75 0 01.75-.75h2.25z" />
          </svg>
        </button>

        <div id="watch-sound-hint" class="pointer-events-none absolute left-1/2 top-5 -translate-x-1/2 rounded-full bg-black/50 px-3 py-1.5 text-xs font-medium text-white backdrop-blur-sm transition-opacity duration-500">
          Tap for sound
        </div>

        <div
          id="watch-paused-indicator"
          class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200"
        >
          <div class="flex h-16 w-16 items-center justify-center rounded-full bg-black/40 backdrop-blur-sm">
            <svg class="h-7 w-7 translate-x-0.5 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>
        </div>

        <!-- End-of-video CTA overlay -->
        <div
          id="watch-end-overlay"
          class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-4 bg-black/80 p-6 text-center opacity-0 backdrop-blur-sm transition-opacity duration-500"
        >
          <p class="text-lg font-bold text-white">Ready to move to Baja?</p>
          <p class="text-sm text-white/70">Get a free, no-obligation quote in about two minutes.</p>
          <a
            href="/#contact"
            class="pointer-events-auto inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-brand-primary to-brand-secondary px-6 py-3 text-sm font-semibold text-white shadow-lg transition-transform hover:scale-105"
          >
            Get my free quote
          </a>
          <button
            id="watch-replay"
            type="button"
            class="pointer-events-auto text-xs font-semibold text-white/60 underline-offset-2 hover:text-white hover:underline"
          >
            Watch again
          </button>
        </div>
      </div>

      {otherVideo && (
        <a
          href={`/watch/${otherVideo.slug}`}
          class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-white/60 transition-colors hover:text-white"
        >
          Watch the next clip
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={2}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </a>
      )}
    </div>

    <!-- CTA + share -->
    <div class="relative z-10 mx-auto w-full max-w-[420px] px-4 pb-8 sm:px-6 sm:pb-12">
      <div class="rounded-2xl border border-white/10 bg-white/5 p-5 text-center backdrop-blur-sm">
        <p class="text-base font-bold text-white">Moving to Baja? Let's make it this easy.</p>
        <p class="mt-1 text-sm text-white/60">Free quote, no pressure — usually ready within a day.</p>
        <a
          href="/#contact"
          class="mt-4 flex w-full items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-brand-primary to-brand-secondary px-6 py-3.5 text-base font-semibold text-white shadow-md transition-all hover:shadow-lg"
        >
          Get my free quote
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={1.5}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        </a>
        <a
          href={`https://wa.me/${siteConfig.contact.whatsapp.replace(/\D/g, '')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2.5 flex w-full items-center justify-center gap-2 rounded-lg border border-white/15 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
        >
          Message us on WhatsApp
        </a>
      </div>

      <div class="relative mt-5 flex items-center justify-center gap-3">
        <span class="text-xs font-medium text-white/50">Share this video:</span>
        <a
          id="watch-share-whatsapp"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share on WhatsApp"
          class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
        </a>
        <button
          id="watch-copy-link"
          type="button"
          aria-label="Copy link"
          class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
          </svg>
        </button>
        <button
          id="watch-native-share"
          type="button"
          aria-label="Share"
          class="hidden h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
          </svg>
        </button>
        <span id="watch-copy-toast" class="pointer-events-none absolute left-1/2 top-full mt-2 -translate-x-1/2 whitespace-nowrap rounded-full bg-white px-3 py-1 text-xs font-semibold text-brand-primary opacity-0 shadow-md transition-opacity duration-300">
          Link copied!
        </span>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ title: video.title, description: video.description }}>
  const videoEl = document.getElementById('watch-video');
  const soundToggle = document.getElementById('watch-sound-toggle');
  const iconMuted = document.getElementById('watch-icon-muted');
  const iconUnmuted = document.getElementById('watch-icon-unmuted');
  const soundHint = document.getElementById('watch-sound-hint');
  const endOverlay = document.getElementById('watch-end-overlay');
  const replayBtn = document.getElementById('watch-replay');
  const shareWhatsapp = document.getElementById('watch-share-whatsapp');
  const copyLinkBtn = document.getElementById('watch-copy-link');
  const copyToast = document.getElementById('watch-copy-toast');
  const nativeShareBtn = document.getElementById('watch-native-share');

  const stage = document.getElementById('watch-stage');

  const setMuted = (muted) => {
    if (!videoEl) return;
    videoEl.muted = muted;
    soundToggle?.setAttribute('aria-pressed', String(!muted));
    iconMuted?.classList.toggle('hidden', !muted);
    iconUnmuted?.classList.toggle('hidden', muted);
    soundHint?.classList.add('opacity-0');
  };

  if (videoEl) {
    videoEl.play().catch(() => {});
    videoEl.addEventListener('play', () => setTimeout(() => soundHint?.classList.add('opacity-0'), 2500));
  }

  // Tap behaviour, TikTok/Reels-style:
  // 1st tap while ambient-muted → just turn sound on (keep playing).
  // tap while playing + unmuted → pause.
  // tap while paused → resume (stays unmuted).
  stage?.addEventListener('click', (e) => {
    if (e.target.closest('button, a')) return;
    if (!videoEl) return;
    if (videoEl.paused) {
      setMuted(false);
      videoEl.play().catch(() => {});
    } else if (videoEl.muted) {
      setMuted(false);
    } else {
      videoEl.pause();
    }
  });

  const pausedIndicator = document.getElementById('watch-paused-indicator');
  videoEl?.addEventListener('play', () => pausedIndicator?.classList.add('opacity-0'));
  videoEl?.addEventListener('pause', () => pausedIndicator?.classList.remove('opacity-0'));

  soundToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!videoEl) return;
    setMuted(!videoEl.muted);
  });

  videoEl?.addEventListener('ended', () => {
    endOverlay?.classList.remove('opacity-0');
    endOverlay?.classList.remove('pointer-events-none');
  });

  replayBtn?.addEventListener('click', () => {
    endOverlay?.classList.add('opacity-0');
    endOverlay?.classList.add('pointer-events-none');
    if (videoEl) {
      videoEl.currentTime = 0;
      videoEl.play().catch(() => {});
    }
  });

  const shareUrl = window.location.href;
  const shareText = `${title} — ${description}`;

  if (shareWhatsapp) {
    shareWhatsapp.href = `https://wa.me/?text=${encodeURIComponent(shareText + ' ' + shareUrl)}`;
  }

  copyLinkBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(shareUrl);
      copyToast?.classList.remove('opacity-0');
      setTimeout(() => copyToast?.classList.add('opacity-0'), 1800);
    } catch {}
  });

  if (navigator.share) {
    nativeShareBtn?.classList.remove('hidden');
    nativeShareBtn?.classList.add('flex');
    nativeShareBtn?.addEventListener('click', () => {
      navigator.share({ title, text: description, url: shareUrl }).catch(() => {});
    });
  }
</script>
