---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { showcaseVideos } from '../data/videos';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const sections = [
  { name: "Home — free moving quote", url: "/" },
  { name: "San Diego local moving", url: "/san-diego-moving/" },
  { name: "Blog", url: "/blog/" },
  { name: "Client reviews", url: "/#reviews" },
  { name: "Common questions", url: "/#faq" },
  { name: "Privacy policy", url: "/privacy/" },
];
---

<Layout
  title="Sitemap | Arnian Moving"
  description="Every page on the Arnian Moving website: moving services between California and Baja, guides, and videos."
>
  <Header />
  <main class="py-12 md:py-16 lg:py-20 bg-brand-bg">
    <div class="container-custom">
      <h1 class="text-3xl sm:text-4xl font-bold mb-8 text-brand-primary">Sitemap</h1>

      <div class="grid gap-6 md:grid-cols-3">
        <section class="bg-white p-6 md:p-8 rounded-xl shadow-sm">
          <h2 class="text-xl font-semibold mb-4 text-brand-primary">Pages</h2>
          <ul class="space-y-2 list-disc pl-5">
            {sections.map((s) => (
              <li><a href={s.url} class="text-brand-primary hover:text-brand-accent">{s.name}</a></li>
            ))}
          </ul>
        </section>

        <section class="bg-white p-6 md:p-8 rounded-xl shadow-sm">
          <h2 class="text-xl font-semibold mb-4 text-brand-primary">Guides</h2>
          <ul class="space-y-2 list-disc pl-5">
            {posts.map((p) => (
              <li><a href={`/blog/${p.slug}/`} class="text-brand-primary hover:text-brand-accent">{p.data.title}</a></li>
            ))}
          </ul>
        </section>

        <section class="bg-white p-6 md:p-8 rounded-xl shadow-sm">
          <h2 class="text-xl font-semibold mb-4 text-brand-primary">Videos</h2>
          <ul class="space-y-2 list-disc pl-5">
            {showcaseVideos.map((v) => (
              <li><a href={`/watch/${v.slug}/`} class="text-brand-primary hover:text-brand-accent">{v.title}</a></li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
