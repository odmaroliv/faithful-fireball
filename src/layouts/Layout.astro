---
import '../styles/global.css';
import { siteConfig } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const site = `https://${siteConfig.domain}`;

// Pages are served as folders (/blog/ , /blog/post/), so the canonical URL
// always ends in "/" — this matches what Google already indexes.
const withSlash = (path: string) => (path.endsWith("/") ? path : `${path}/`);

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogImage = `${site}/images/og-image.jpg`,
  ogType = "website",
  canonicalPath = Astro.url.pathname,
  noindex = false,
} = Astro.props;

const canonical = `${site}${withSlash(canonicalPath)}`;

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "MovingCompany",
  "@id": `${site}/#company`,
  name: siteConfig.company.name,
  legalName: siteConfig.company.legalName,
  description: siteConfig.description,
  url: `${site}/`,
  logo: `${site}/images/logo.png`,
  image: `${site}/images/og-image.jpg`,
  telephone: siteConfig.contact.phone,
  email: siteConfig.contact.email,
  foundingDate: String(siteConfig.company.foundedYear),
  knowsLanguage: ["en", "es"],
  address: siteConfig.contact.locations.map((loc) => ({
    "@type": "PostalAddress",
    streetAddress: loc.address,
    addressLocality: loc.city,
    addressRegion: loc.state,
    postalCode: loc.postalCode,
    addressCountry: loc.country,
  })),
  areaServed: [
    { "@type": "State", name: "California" },
    { "@type": "State", name: "Baja California" },
    { "@type": "State", name: "Baja California Sur" },
    ...siteConfig.destinations.map((name) => ({ "@type": "City", name })),
  ],
  parentOrganization: {
    "@type": "Organization",
    name: "Arnian Group",
    url: "https://arniangroup.com/",
  },
  sameAs: [siteConfig.social.facebook, siteConfig.social.instagram, siteConfig.social.linkedin],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/icono.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Social sharing -->
    <meta property="og:site_name" content={siteConfig.company.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Font preloads -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Merriweather:wght@400;700&display=swap" rel="stylesheet">

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)}></script>

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1323378182285466');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1323378182285466&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->

    <!-- Global site tag (gtag.js) - Google Analytics -->
     <!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=AW-666721564"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'AW-666721564');
</script>
  </head>
  <body class="bg-brand-bg text-brand-primary font-sans">
    <slot />
  </body>
</html>