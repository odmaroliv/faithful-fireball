---
import { testimonials } from "../data/testimonials";

interface Props {
  heading?: string;
}

const { heading = "In our clients' own words" } = Astro.props;
---

<section id="reviews" class="py-14 md:py-20 bg-white" aria-labelledby="reviews-heading">
  <div class="container-custom">
    <div class="text-center max-w-2xl mx-auto mb-10 md:mb-14">
      <h2 id="reviews-heading" class="text-2xl sm:text-3xl md:text-4xl font-bold mb-4 text-brand-primary">{heading}</h2>
      <p class="text-base sm:text-lg text-brand-gray">
        Letters our clients and partners sent us after their move. Unedited, and shared with their permission.
      </p>
    </div>

    <div class="grid gap-6 md:gap-8 lg:grid-cols-3">
      {testimonials.map((t) => (
        <figure class="flex h-full flex-col rounded-xl border border-brand-border bg-brand-bg/60 p-6 md:p-7">
          <svg class="mb-4 h-8 w-8 text-brand-secondary/60" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M9.5 6C6.5 6 4 8.5 4 11.5V18h6v-6H7c0-1.7 1.1-3 2.5-3V6zm10 0c-3 0-5.5 2.5-5.5 5.5V18h6v-6h-3c0-1.7 1.1-3 2.5-3V6z" />
          </svg>
          <blockquote class="flex-grow text-base leading-relaxed text-brand-gray">
            <p>“{t.excerpt}”</p>
          </blockquote>
          <figcaption class="mt-6 border-t border-brand-border pt-4">
            <p class="font-semibold text-brand-primary">{t.author}</p>
            <p class="text-sm text-brand-gray/80">
              {t.role ? `${t.role} · ${t.place}` : t.place}
            </p>
          </figcaption>
          <details class="group mt-4">
            <summary class="cursor-pointer list-none text-sm font-semibold text-brand-accent hover:text-brand-blue-dark focus:outline-none focus-visible:underline">
              <span class="group-open:hidden">Read the full letter</span>
              <span class="hidden group-open:inline">Hide the letter</span>
            </summary>
            <div class="mt-3 space-y-3 text-sm leading-relaxed text-brand-gray">
              {t.letter.map((p) => <p>{p}</p>)}
              <p class="font-medium text-brand-primary">— {t.author}{t.date ? `, ${t.date}` : ""}</p>
            </div>
          </details>
        </figure>
      ))}
    </div>
  </div>
</section>
