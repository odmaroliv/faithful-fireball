---
import { showcaseVideos } from "../data/videos";
---

<section id="moving-day" class="py-14 md:py-20 bg-brand-bg" aria-labelledby="moving-day-heading">
  <div class="container-custom">
    <div class="mx-auto mb-10 max-w-2xl text-center md:mb-12">
      <h2 id="moving-day-heading" class="text-2xl font-bold text-brand-primary sm:text-3xl md:text-4xl">
        See a move from start to finish
      </h2>
      <p class="mt-4 text-base text-brand-gray sm:text-lg">
        Short clips filmed by our crews on the road and on site. Press play when you're ready.
      </p>
    </div>

    <div class="mx-auto grid max-w-3xl grid-cols-1 gap-8 sm:grid-cols-2">
      {showcaseVideos.map((v) => (
        <figure class="overflow-hidden rounded-2xl border border-brand-border bg-white shadow-custom">
          <video
            class="aspect-[9/16] w-full bg-brand-blue-dark object-cover"
            src={v.src}
            poster={v.poster.replace(/\.jpg$/, ".webp")}
            controls
            playsinline
            preload="none"
            width="720"
            height="1280"
            aria-label={v.label}
          ></video>
          <figcaption class="p-4 md:p-5">
            <p class="font-semibold text-brand-primary">{v.title}</p>
            <p class="mt-1 text-sm leading-relaxed text-brand-gray">{v.description}</p>
            <a href={`/watch/${v.slug}/`} class="mt-3 inline-block text-sm font-semibold text-brand-accent hover:underline">
              Open full screen
            </a>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
