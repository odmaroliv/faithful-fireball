---
import { siteConfig } from '../config/site';

const currentYear = new Date().getFullYear();

const footerLinks = [
  {
    title: "Moving",
    links: [
      { text: "Get a free quote", url: "/#contact" },
      { text: "Services", url: "/#services" },
      { text: "How it works", url: "/#how-it-works" },
      { text: "San Diego local moves", url: "/san-diego-moving/" },
    ]
  },
  {
    title: "Guides",
    links: [
      { text: "Moving to Cabo San Lucas", url: "/blog/moving-to-cabo-san-lucas-essential-guide-for-new-homeowners/" },
      { text: "Moving to San José del Cabo", url: "/blog/the-complete-san-jose-del-cabo-relocation-guide/" },
      { text: "Moving to Loreto", url: "/blog/relocating-to-loreto-complete-moving-guide-for-new-homeowners/" },
      { text: "All articles", url: "/blog/" },
    ]
  },
  {
    title: "Company",
    links: [
      { text: "Client reviews", url: "/#reviews" },
      { text: "Common questions", url: "/#faq" },
      { text: "Our work", url: "/#our-work" },
      { text: "Privacy policy", url: "/privacy/" },
    ]
  }
];

const social = [
  { label: "Facebook", url: siteConfig.social.facebook, path: "M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z" },
  { label: "Instagram", url: siteConfig.social.instagram, path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" },
  { label: "LinkedIn", url: siteConfig.social.linkedin, path: "M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" },
];
---

<footer class="pt-12 pb-6 md:pt-16 md:pb-8 bg-brand-primary text-white">
  <div class="container-custom">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-10 mb-10 md:mb-12">
      <div class="lg:col-span-2">
        <img src="/images/logo.png" alt={siteConfig.company.name} width="240" height="75" class="h-12 md:h-16 w-auto mb-4 bg-white p-2 rounded" loading="lazy">
        <p class="text-white/85 mb-5 max-w-md text-sm md:text-base">
          {siteConfig.description}
        </p>

        <address class="not-italic space-y-3 text-sm md:text-base text-white/85">
          <p>
            Call: <a href={`tel:${siteConfig.contact.phoneLink}`} class="font-semibold text-white hover:underline">{siteConfig.contact.phone}</a>
            <span class="text-white/60"> · {siteConfig.contact.operatingHours}</span>
          </p>
          <p>
            WhatsApp:
            <a href={`https://wa.me/${siteConfig.contact.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer" class="font-semibold text-white hover:underline">{siteConfig.contact.whatsappDisplay}</a>
          </p>
          <p><a href={`mailto:${siteConfig.contact.email}`} class="hover:underline">{siteConfig.contact.email}</a></p>
          {siteConfig.contact.locations.map((loc) => (
            <p>
              <span class="font-semibold text-white">{loc.city}:</span>
              {` ${loc.address}, ${loc.city}, ${loc.state} ${loc.postalCode}, ${loc.country === "US" ? "USA" : "México"}`}
            </p>
          ))}
        </address>

        <div class="flex gap-3 mt-5">
          {social.map((s) => (
            <a href={s.url} aria-label={`${siteConfig.company.name} on ${s.label}`} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center text-white hover:bg-white/20 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
                <path d={s.path} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      {footerLinks.map(column => (
        <nav aria-label={column.title}>
          <h2 class="text-base lg:text-lg font-semibold mb-3 md:mb-4 text-white">{column.title}</h2>
          <ul class="space-y-2">
            {column.links.map(link => (
              <li>
                <a href={link.url} class="text-sm md:text-base text-white/80 hover:text-white transition-colors">
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="pt-6 md:pt-8 border-t border-white/15 flex flex-col md:flex-row justify-between items-center gap-4 text-xs md:text-sm text-white/70">
      <p>&copy; {currentYear} {siteConfig.company.name}. All rights reserved.</p>
      <p>
        <a href="https://arniangroup.com/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
          {siteConfig.company.name} is part of <span class="font-semibold">Arnian Group</span>
        </a>
        <span aria-hidden="true"> · </span>
        <a href="/sitemap/" class="hover:text-white transition-colors">Sitemap</a>
      </p>
    </div>
  </div>
</footer>
