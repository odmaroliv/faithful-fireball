---
import ContactWizard from './ContactWizard.jsx';
import { siteConfig } from '../config/site';
---

<section id="contact" aria-label="Free moving quote">
  <ContactWizard client:only="react" />
  <noscript>
    <p class="mx-auto max-w-xl px-4 py-8 text-center text-brand-gray">
      To request a quote, call us at <a class="font-semibold underline" href={`tel:${siteConfig.contact.phoneLink}`}>{siteConfig.contact.phone}</a>
      or email <a class="font-semibold underline" href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>.
    </p>
  </noscript>
</section>