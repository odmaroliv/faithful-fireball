---
const photos = [
  {
    src: "/images/Arnian-Moving-Baja-1.webp",
    alt: "Arnian Moving crew carrying furniture up an outdoor staircase",
    title: "Tricky access",
    caption: "Stairs, hillsides and narrow streets",
    span: "",
  },
  {
    src: "/images/Arnian-Moving-Baja-2.webp",
    alt: "Crew members wrapping and packing a client's belongings",
    title: "Careful packing",
    caption: "Every item wrapped and labeled",
    span: "",
  },
  {
    src: "/images/Arnian-Moving-Baja-3.webp",
    alt: "Arnian Moving truck parked near the beach in Baja",
    title: "Beach and resort homes",
    caption: "Oceanfront deliveries across Baja",
    span: "",
  },
  {
    src: "/images/Arnian-Moving-Baja-4.webp",
    alt: "Large Arnian Moving truck in front of a residential home",
    title: "Whole-home moves",
    caption: "Homes of every size",
    span: "md:col-span-2",
  },
  {
    src: "/images/Arnian-Moving-Baja-5.webp",
    alt: "Crew handling a wrapped piece of furniture outdoors",
    title: "Delicate items",
    caption: "Art, antiques and heirlooms",
    span: "",
  },
];
---

<section id="our-work" class="py-14 md:py-20 bg-white" aria-labelledby="our-work-heading">
  <div class="container-custom">
    <div class="text-center max-w-2xl mx-auto mb-10 md:mb-12">
      <h2 id="our-work-heading" class="text-2xl sm:text-3xl md:text-4xl font-bold mb-4 text-brand-primary">
        Real moves, real crews
      </h2>
      <p class="text-base sm:text-lg text-brand-gray">
        Photos from our own jobs across California and Baja — no stock images.
      </p>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
      {photos.map((p) => (
        <li class={`relative overflow-hidden rounded-xl shadow-sm h-64 md:h-72 ${p.span}`}>
          <img
            src={p.src}
            alt={p.alt}
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-blue-dark/85 to-transparent p-4 pt-10">
            <p class="font-semibold text-white">{p.title}</p>
            <p class="text-sm text-white/90">{p.caption}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
